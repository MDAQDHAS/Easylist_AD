# ==============================================================================
# EasyList Backend Environment Configuration (.env.example)
# Copy this file to .env for local server development. Never commit real secrets.
# ==============================================================================

# Server Port
PORT=8000

# Frontend Allowed Origin (for CORS)
FRONTEND_URL="http://localhost:5173"

# Supabase Server-Side Database Configuration
# Obtain from Supabase Project Settings > API
SUPABASE_URL="https://eqirxktohtqvrfkxdmfk.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YourSupabaseServiceRoleKeyPlaceholder"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_key_placeholder"

# Firebase Admin SDK Credentials (Server-Only Secrets)
# Option A: Path to Service Account JSON file (recommended in GCP/production)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Option B: Explicit Environment Variables
# Obtain from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID="easylist-588d9"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@easylist-588d9.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option C: Full Service Account JSON string (single line)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"easylist-588d9",...}'

# Optional transactional email configuration for future account-recovery flows.
# Keep both values server-side. Never use VITE_ prefixes for provider credentials.
# POSTMARK_SERVER_TOKEN=""
# POSTMARK_FROM_EMAIL=""

# Required before enabling shared account-linking initiation rate limits.
# Use a cryptographically random secret of at least 32 bytes.
# ACCOUNT_LINKING_RATE_LIMIT_HMAC_KEY=""

# Gemini API key used only by the authenticated backend OCR endpoint.
GEMINI_API_KEY=""
GEMINI_API_KEY=
