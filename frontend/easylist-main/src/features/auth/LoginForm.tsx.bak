import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { Mail, Lock, Eye, EyeOff, ChevronRight, Loader2, AlertCircle, CheckCircle2 } from 'lucide-react';
import { ROUTES } from '../../routes/paths';
import { storage } from '../../lib/storage';
import { DEMO_USER } from '../../lib/constants';

interface LoginFormProps {
  onSuccess?: (email: string) => void;
  onSwitchToRegister?: () => void;
  onForgotPassword?: () => void;
  defaultEmail?: string;
  defaultPassword?: string;
}

export const LoginForm: React.FC<LoginFormProps> = ({
  onSuccess,
  onSwitchToRegister,
  onForgotPassword,
  defaultEmail = 'owner@avenzogrocery.com',
  defaultPassword = 'password123',
}) => {
  const navigate = useNavigate();

  const [email, setEmail] = useState(defaultEmail);
  const [password, setPassword] = useState(defaultPassword);
  const [showPassword, setShowPassword] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [generalError, setGeneralError] = useState('');
  const [emailError, setEmailError] = useState('');
  const [passwordError, setPasswordError] = useState('');
  const [loginSuccess, setLoginSuccess] = useState(false);

  const validate = (): boolean => {
    let isValid = true;
    setEmailError('');
    setPasswordError('');
    setGeneralError('');

    const cleanEmail = email.trim();
    if (!cleanEmail) {
      setEmailError('Email address is required');
      isValid = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
      setEmailError('Please enter a valid email address');
      isValid = false;
    }

    if (!password) {
      setPasswordError('Password is required');
      isValid = false;
    } else if (password.length < 6) {
      setPasswordError('Password must be at least 6 characters');
      isValid = false;
    }

    return isValid;
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();

    if (!validate()) {
      return;
    }

    setIsLoading(true);
    setGeneralError('');

    // Workable frontend sign in simulation
    setTimeout(() => {
      setIsLoading(false);
      setLoginSuccess(true);

      const loggedUser = {
        ...DEMO_USER,
        email: email.trim() || DEMO_USER.email,
      };
      storage.setUser(loggedUser);

      if (onSuccess) {
        onSuccess(email.trim());
      }

      // Smooth transition to dashboard
      setTimeout(() => {
        navigate(ROUTES.DASHBOARD);
      }, 700);
    }, 600);
  };

  return (
    <div className="w-full max-w-[1080px] bg-white rounded-[24px] sm:rounded-[32px] shadow-[0_12px_45px_rgba(17,28,53,0.08)] border border-[#E2E8F0]/80 p-3 sm:p-4 lg:p-5 flex flex-col lg:flex-row gap-4 sm:gap-6 lg:gap-8 overflow-hidden">
      {/* =========================================================================
          LEFT PANE: Dark Navy Brand Presentation (#111C35)
          ========================================================================= */}
      <div className="w-full lg:w-[48%] xl:w-[47%] bg-[#111C35] rounded-[20px] sm:rounded-[24px] p-6 sm:p-8 lg:p-10 flex flex-col justify-between relative overflow-hidden text-white shadow-inner">
        {/* Subtle decorative background glow */}
        <div className="absolute top-0 right-0 w-64 h-64 bg-[#087BFA]/10 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>

        <div>
          {/* Brand Logo & Name */}
          <div className="flex items-center gap-3">
            <img
              src="/images/EasyList logo.png"
              alt="EasyList Logo"
              className="w-9 h-9 sm:w-10 sm:h-10 rounded-xl object-contain shadow-md"
            />
            <span className="text-xl sm:text-2xl font-bold font-heading tracking-tight text-white select-none">
              Easy<span className="text-[#087BFA]">List</span>
            </span>
          </div>

          {/* Headline */}
          <div className="mt-7 sm:mt-10">
            <h2 className="text-2xl sm:text-3xl lg:text-[32px] font-bold text-white font-heading leading-tight tracking-tight">
              From Handwritten <br />
              to <span className="text-[#087BFA]">Digital.</span>
            </h2>
            <p className="text-xs sm:text-sm text-slate-300 font-normal mt-3 leading-relaxed max-w-sm">
              Turn handwritten orders into editable product lists in seconds.
            </p>
          </div>
        </div>

        {/* Center Visual Artwork: Handwritten Chit -> Digital Extracted List */}
        <div className="my-6 sm:my-8 flex items-center justify-center">
          <img
            src="/images/EasyList login image.png"
            alt="Handwritten to Digital Order Conversion"
            className="w-full max-w-[320px] sm:max-w-[360px] lg:max-w-[390px] object-contain drop-shadow-2xl select-none transition-transform hover:scale-[1.01] duration-300"
          />
        </div>

        {/* Brand Footer */}
        <div className="pt-2 sm:pt-4 border-t border-slate-700/40 text-center">
          <span className="text-[11px] sm:text-xs text-slate-400 font-medium tracking-wide">
            A product by Avenzo Technologies
          </span>
        </div>
      </div>

      {/* =========================================================================
          RIGHT PANE: White Sign In Form
          ========================================================================= */}
      <div className="w-full lg:w-[52%] xl:w-[53%] bg-white flex flex-col justify-center items-center p-4 sm:p-8 lg:p-12">
        <div className="w-full max-w-[380px] sm:max-w-[400px]">
          {/* Circular Navy Brand Avatar Badge */}
          <div className="flex justify-center mb-4 sm:mb-5">
            <div className="w-16 h-16 rounded-full bg-[#111C35] flex items-center justify-center shadow-md p-3 ring-4 ring-[#F0F5FC]">
              <img
                src="/images/EasyList logo.png"
                alt="EasyList"
                className="w-full h-full object-contain"
              />
            </div>
          </div>

          {/* Heading */}
          <div className="text-center mb-6 sm:mb-8">
            <h1 className="text-2xl sm:text-3xl font-bold font-heading text-[#111827] tracking-tight">
              Welcome <span className="text-[#087BFA]">Back</span>
            </h1>
            <p className="text-xs sm:text-sm text-[#64748B] mt-1.5 font-normal">
              Sign in to continue to EasyList
            </p>
          </div>

          {/* Feedback Alerts */}
          {generalError && (
            <div
              role="alert"
              className="mb-5 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs sm:text-sm flex items-start gap-2 animate-in fade-in duration-200"
            >
              <AlertCircle className="w-4 h-4 mt-0.5 shrink-0 text-red-600" />
              <span>{generalError}</span>
            </div>
          )}

          {loginSuccess && (
            <div
              role="status"
              className="mb-5 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm flex items-center gap-2 animate-in fade-in duration-200"
            >
              <CheckCircle2 className="w-4 h-4 shrink-0 text-emerald-600" />
              <span>Signed in successfully! Redirecting to Dashboard...</span>
            </div>
          )}

          {/* Form */}
          <form onSubmit={handleSubmit} noValidate className="space-y-4 sm:space-y-5">
            {/* Email Address */}
            <div>
              <label
                htmlFor="email-input"
                className="block text-xs sm:text-sm font-semibold text-[#111827] mb-1.5"
              >
                Email address
              </label>
              <div className="relative flex items-center">
                <span className="absolute left-3.5 text-[#8296B5] pointer-events-none flex items-center">
                  <Mail className="w-4 h-4 sm:w-5 sm:h-5" />
                </span>
                <input
                  id="email-input"
                  type="email"
                  autoComplete="email"
                  value={email}
                  onChange={(e) => {
                    setEmail(e.target.value);
                    if (emailError) setEmailError('');
                  }}
                  placeholder="Enter your email"
                  aria-invalid={!!emailError}
                  aria-describedby={emailError ? 'email-error' : undefined}
                  className={`w-full pl-10 sm:pl-11 pr-4 py-2.5 sm:py-3.5 bg-white border ${
                    emailError ? 'border-red-400 focus:border-red-500 focus:ring-red-500/15' : 'border-[#DCE5F2] focus:border-[#087BFA] focus:ring-[#087BFA]/15'
                  } rounded-xl text-sm sm:text-base text-[#111827] placeholder-[#8296B5] transition-all focus:outline-none focus:ring-4 hover:border-[#B8CDE6]`}
                  required
                />
              </div>
              {emailError && (
                <p id="email-error" className="text-xs text-red-600 mt-1.5 flex items-center gap-1">
                  <AlertCircle className="w-3.5 h-3.5" />
                  {emailError}
                </p>
              )}
            </div>

            {/* Password */}
            <div>
              <label
                htmlFor="password-input"
                className="block text-xs sm:text-sm font-semibold text-[#111827] mb-1.5"
              >
                Password
              </label>
              <div className="relative flex items-center">
                <span className="absolute left-3.5 text-[#8296B5] pointer-events-none flex items-center">
                  <Lock className="w-4 h-4 sm:w-5 sm:h-5" />
                </span>
                <input
                  id="password-input"
                  type={showPassword ? 'text' : 'password'}
                  autoComplete="current-password"
                  value={password}
                  onChange={(e) => {
                    setPassword(e.target.value);
                    if (passwordError) setPasswordError('');
                  }}
                  placeholder="Enter your password"
                  aria-invalid={!!passwordError}
                  aria-describedby={passwordError ? 'password-error' : undefined}
                  className={`w-full pl-10 sm:pl-11 pr-11 py-2.5 sm:py-3.5 bg-white border ${
                    passwordError ? 'border-red-400 focus:border-red-500 focus:ring-red-500/15' : 'border-[#DCE5F2] focus:border-[#087BFA] focus:ring-[#087BFA]/15'
                  } rounded-xl text-sm sm:text-base text-[#111827] placeholder-[#8296B5] transition-all focus:outline-none focus:ring-4 hover:border-[#B8CDE6]`}
                  required
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  className="absolute right-3.5 text-[#8296B5] hover:text-[#111827] transition-colors p-1 rounded-md focus:outline-none focus:ring-2 focus:ring-[#087BFA]/30"
                  aria-label={showPassword ? 'Hide password' : 'Show password'}
                >
                  {showPassword ? (
                    <EyeOff className="w-4 h-4 sm:w-5 sm:h-5" />
                  ) : (
                    <Eye className="w-4 h-4 sm:w-5 sm:h-5" />
                  )}
                </button>
              </div>
              {passwordError && (
                <p id="password-error" className="text-xs text-red-600 mt-1.5 flex items-center gap-1">
                  <AlertCircle className="w-3.5 h-3.5" />
                  {passwordError}
                </p>
              )}
            </div>

            {/* Forgot Password Link / Modal Trigger */}
            <div className="flex justify-end pt-1">
              {onForgotPassword ? (
                <button
                  id="btn-forgot-password-trigger"
                  type="button"
                  onClick={onForgotPassword}
                  className="text-xs sm:text-sm font-medium text-[#5046F2] hover:text-[#4338CA] transition-colors cursor-pointer bg-transparent border-none p-0 inline font-sans"
                >
                  Forgot Password?
                </button>
              ) : (
                <Link
                  to={ROUTES.FORGOT_PASSWORD}
                  id="btn-forgot-password-link"
                  className="text-xs sm:text-sm font-medium text-[#5046F2] hover:text-[#4338CA] transition-colors"
                >
                  Forgot Password?
                </Link>
              )}
            </div>

            {/* Sign In Button */}
            <button
              type="submit"
              disabled={isLoading || loginSuccess}
              className="w-full py-3 sm:py-3.5 px-6 rounded-xl bg-[#087BFA] hover:bg-[#076ee2] active:bg-[#0660c5] text-white font-semibold text-sm sm:text-base flex items-center justify-center gap-2 shadow-[0_4px_14px_rgba(8,123,250,0.3)] hover:shadow-[0_6px_20px_rgba(8,123,250,0.38)] active:scale-[0.99] transition-all cursor-pointer disabled:opacity-70 disabled:cursor-not-allowed mt-5"
            >
              {isLoading ? (
                <>
                  <Loader2 className="w-5 h-5 animate-spin" />
                  <span>Signing In...</span>
                </>
              ) : (
                <>
                  <span>Sign In</span>
                  <ChevronRight className="w-5 h-5 stroke-[2.5]" />
                </>
              )}
            </button>
          </form>

          {/* Create Account Link */}
          <div className="text-center text-xs sm:text-sm text-[#64748B] pt-6 sm:pt-7 font-normal">
            Don't have an account?{' '}
            {onSwitchToRegister ? (
              <button
                type="button"
                onClick={onSwitchToRegister}
                className="text-[#087BFA] font-semibold hover:underline ml-0.5 cursor-pointer bg-transparent border-none p-0 inline"
              >
                Create Account
              </button>
            ) : (
              <Link
                to={ROUTES.REGISTER}
                className="text-[#087BFA] font-semibold hover:underline ml-0.5"
              >
                Create Account
              </Link>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};
