# ==============================================================================
# EasyList Frontend Environment Configuration (.env.example)
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Application Information
VITE_APP_NAME="EasyList"
VITE_APP_VERSION="1.0.0"
VITE_COMPANY_NAME="Avenzo Technologies"
VITE_APP_ENV="development"

# Backend API Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_API_TIMEOUT_MS="30000"

# Firebase Public Web Configuration (Safe for browser client exposure)
# Obtain these values from the Firebase Console: Project Settings > General > Your Apps > Web app config
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="easylist-d1553.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="easylist-d1553"
VITE_FIREBASE_STORAGE_BUCKET="easylist-d1553.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
